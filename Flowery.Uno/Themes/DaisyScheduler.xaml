<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Flowery.Controls">

    <!--
        The styles below reference these tokens. On WinUI a resource that is missing when a style
        is applied fails the tree insertion, and DaisyTokenDefaults only runs on Loaded.
        Values mirror DaisyTokenDefaults. DaisySchedulerTodayBrush and DaisySchedulerEventBackgroundBrush
        are derived from the palette in code, so they follow theme changes; define them to override.
    -->
    <Thickness x:Key="DaisySchedulerToolbarMargin">8</Thickness>
    <Thickness x:Key="DaisySchedulerToolbarItemMargin">2</Thickness>
    <Thickness x:Key="DaisySchedulerViewButtonsMargin">8,0,8,0</Thickness>
    <Thickness x:Key="DaisySchedulerTooltipPadding">12,8,12,8</Thickness>

    <Style TargetType="controls:DaisyScheduler">
        <Setter Property="Background" Value="{ThemeResource DaisyBase100Brush}" />
        <Setter Property="Foreground" Value="{ThemeResource DaisyBaseContentBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DaisyBase300Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:DaisyScheduler">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <controls:WrapPanel x:Name="PART_Toolbar" Margin="{StaticResource DaisySchedulerToolbarMargin}" Orientation="Horizontal">
                                <controls:DaisyButton Tag="Previous" Content="‹" Variant="Ghost" Margin="{StaticResource DaisySchedulerToolbarItemMargin}" />
                                <controls:DaisyButton x:Name="PART_Date" Tag="Date" Variant="Ghost" Margin="{StaticResource DaisySchedulerToolbarItemMargin}" />
                                <controls:DaisyButton Tag="Next" Content="›" Variant="Ghost" Margin="{StaticResource DaisySchedulerToolbarItemMargin}" />
                                <controls:DaisyButton Tag="Today" Variant="Ghost" Margin="{StaticResource DaisySchedulerToolbarItemMargin}" />
                                <controls:WrapPanel x:Name="PART_Views" Orientation="Horizontal" Margin="{StaticResource DaisySchedulerViewButtonsMargin}" />
                                <controls:WrapPanel x:Name="PART_CustomButtons" Orientation="Horizontal" />
                                <controls:DaisyButton Tag="Settings" Variant="Ghost" Margin="{StaticResource DaisySchedulerToolbarItemMargin}" />
                            </controls:WrapPanel>
                            <Border x:Name="PART_ViewHost" Grid.Row="1" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Hover popups and the settings flyout share the Base200 surface. -->
    <Style x:Key="DaisySchedulerToolTipStyle" TargetType="ToolTip">
        <Setter Property="Background" Value="{ThemeResource DaisyBase200Brush}" />
        <Setter Property="Foreground" Value="{ThemeResource DaisyBaseContentBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DaisyBaseContentMutedBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="{StaticResource DaisySchedulerTooltipPadding}" />
    </Style>

    <Style x:Key="DaisySchedulerFlyoutPresenterStyle" TargetType="FlyoutPresenter">
        <Setter Property="Background" Value="{ThemeResource DaisyBase200Brush}" />
        <Setter Property="Foreground" Value="{ThemeResource DaisyBaseContentBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DaisyBaseContentMutedBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="{StaticResource DaisySchedulerTooltipPadding}" />
    </Style>
</ResourceDictionary>
