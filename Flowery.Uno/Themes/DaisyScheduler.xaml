<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Flowery.Controls">

    <!--
        The styles below reference these tokens. On WinUI a resource that is missing when a style
        is applied fails the tree insertion, and DaisyTokenDefaults only runs on Loaded.
        Values mirror DaisyTokenDefaults. DaisySchedulerTodayBrush and DaisySchedulerEventBackgroundBrush
        are derived from the palette in code, so they follow theme changes; define them to override.
    -->
    <Thickness x:Key="DaisySchedulerToolbarMargin">8</Thickness>
    <x:Double x:Key="DaisySchedulerToolbarIconSize">20</x:Double>
    <Thickness x:Key="DaisySchedulerTooltipPadding">12,8,12,8</Thickness>

    <Style TargetType="controls:DaisyScheduler">
        <Setter Property="Background" Value="{ThemeResource DaisyBase100Brush}" />
        <Setter Property="Foreground" Value="{ThemeResource DaisyBaseContentBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DaisyBase300Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:DaisyScheduler">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <controls:DaisySchedulerToolbar x:Name="PART_Toolbar" Margin="{StaticResource DaisySchedulerToolbarMargin}" />
                            <Border x:Name="PART_ViewHost" Grid.Row="1" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The buttons of DaisySchedulerToolbar. The toolbar sets their colors, paddings and heights for the size and the
         state, so the template only draws them. -->
    <Style x:Key="DaisySchedulerToolbarButtonStyle" TargetType="Button">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                      CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}"
                                      Foreground="{TemplateBinding Foreground}" Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Hover popups and the settings flyout share the Base200 surface. -->
    <Style x:Key="DaisySchedulerToolTipStyle" TargetType="ToolTip">
        <Setter Property="Background" Value="{ThemeResource DaisyBase200Brush}" />
        <Setter Property="Foreground" Value="{ThemeResource DaisyBaseContentBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DaisyBaseContentMutedBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="{StaticResource DaisySchedulerTooltipPadding}" />
    </Style>

    <Style x:Key="DaisySchedulerFlyoutPresenterStyle" TargetType="FlyoutPresenter">
        <Setter Property="Background" Value="{ThemeResource DaisyBase200Brush}" />
        <Setter Property="Foreground" Value="{ThemeResource DaisyBaseContentBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DaisyBaseContentMutedBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="{StaticResource DaisySchedulerTooltipPadding}" />
    </Style>
</ResourceDictionary>
