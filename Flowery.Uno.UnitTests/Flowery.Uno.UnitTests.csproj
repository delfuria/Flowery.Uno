<Project Sdk="Uno.Sdk/6.5.33">
  <PropertyGroup>
    <TargetFrameworks>net10.0-desktop;net10.0-windows10.0.19041</TargetFrameworks>
    <!-- Rider reads this list before Uno.Sdk filters it: list Windows only when building on Windows -->
    <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('Windows'))">net10.0-desktop</TargetFrameworks>
    <UnoVersion>6.5.229</UnoVersion>
    <UnoSingleProject>true</UnoSingleProject>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <!-- Match Flowery.Uno's platform to avoid MSB3270 architecture mismatch -->
    <RuntimeIdentifier>$(FloweryWindowsRuntimeIdentifier)</RuntimeIdentifier>
    <Platform>$(FloweryWindowsPlatform)</Platform>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" />
    <PackageReference Include="MSTest.TestFramework" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.Analyzers" />
    <PackageReference Include="Combinatorial.MSTest" />
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Flowery.Uno\Flowery.Uno.csproj" />
  </ItemGroup>
</Project>
